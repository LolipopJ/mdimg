{
  "name": "mdimg",
  "version": "2.2.0",
  "description": "Covert Markdown or HTML to image",
  "keywords": [
    "markdown",
    "html",
    "image",
    "md2img",
    "html2img"
  ],
  "engines": {
    "node": ">= 22.12.0"
  },
  "main": "lib/mdimg.js",
  "module": "lib/mdimg.mjs",
  "types": "lib/mdimg.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./lib/mdimg.d.mts",
        "default": "./lib/mdimg.mjs"
      },
      "require": {
        "types": "./lib/mdimg.d.ts",
        "default": "./lib/mdimg.js"
      }
    }
  },
  "bin": {
    "mdimg": "bin/mdimg.js"
  },
  "files": [
    "README.md",
    "bin/",
    "lib/",
    "src/",
    "template/css/",
    "template/html/"
  ],
  "scripts": {
    "mdimg": "node ./bin/mdimg.js",
    "lint": "eslint .",
    "lint:fix": "pnpm run lint --fix",
    "stylelint": "stylelint template/scss/**/*.scss site/src/**/*.css",
    "stylelint:fix": "pnpm run stylelint --fix",
    "test": "jest --roots test --maxWorkers 5 --testTimeout 60000",
    "test:consumer": "jest --config jest.consumer.config.js --runInBand --testTimeout 360000",
    "typecheck": "tsc --noEmit",
    "build": "node ./script/build.mjs",
    "build:ts": "rollup -c rollup.config.js --bundleConfigAsCjs",
    "build:sass": "rollup -c rollup.sass.config.js --bundleConfigAsCjs",
    "build:assets": "node ./script/build-assets.mjs",
    "preview": "node ./script/generate-previews.mjs",
    "site:dev": "vite --config site/vite.config.ts",
    "site:build": "vite build --config site/vite.config.ts",
    "site:preview": "vite preview --config site/vite.config.ts",
    "site:typecheck": "tsc -p site/tsconfig.json",
    "site:test": "jest --config jest.site.config.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LolipopJ/mdimg.git"
  },
  "author": "LolipopJ",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/LolipopJ/mdimg/issues"
  },
  "homepage": "https://github.com/LolipopJ/mdimg#readme",
  "dependencies": {
    "cheerio": "^1.2.0",
    "commander": "^15.0.0",
    "marked": "^18.0.0",
    "puppeteer": "^25.0.0"
  },
  "peerDependencies": {
    "@types/node": ">=22.12.0"
  },
  "devDependencies": {
    "@babel/core": "^8.0.6",
    "@babel/node": "^8.0.6",
    "@babel/preset-env": "^8.0.6",
    "@eslint/js": "^10.0.1",
    "@mathjax/mathjax-newcm-font": "^4.1.3",
    "@rollup/plugin-babel": "^7.1.0",
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-terser": "^1.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.12.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "dompurify": "^3.4.16",
    "dts-bundle-generator": "^9.5.1",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "github-markdown-css": "^5.9.0",
    "globals": "^17.13.0",
    "highlight.js": "^11.12.0",
    "html-to-image": "^1.11.13",
    "jest": "^30.5.2",
    "katex": "^0.16.47",
    "mathjax": "^4.1.3",
    "mermaid": "^12.1.0",
    "normalize.css": "^8.0.1",
    "pdfjs-dist": "^6.4.299",
    "prettier": "^3.9.10",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "rollup": "^4.64.5",
    "rollup-plugin-license": "^3.7.1",
    "rollup-plugin-scss": "^4.0.1",
    "rollup-plugin-typescript2": "^0.37.0",
    "sass": "^1.105.1",
    "stylelint": "^17.16.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "tslib": "^2.8.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.4"
  }
}
